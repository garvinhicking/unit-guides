
<div class="toc-header">
    <div class="toc-title">
        {% set pagerLinks = getPagerLinks() %}
        {%- for link in pagerLinks -%}
            {%- if link.relation=='top' -%}
                <a class="toc-title-project" href="{{ link.url }}">{{ env.projectNode.title }}</a>
            {% endif -%}
        {%- endfor -%}

        {% if env.projectNode.version and not getSettings('disable_version_switch') -%}
            <div class="toc-version-wrapper" id="toc-version-wrapper">
                <!-- no tookies for you -->
            </div>
        {%- endif -%}
    </div>
    <div class="toc-actions">
        <button id="toc-toggle" class="btn btn-light d-block d-lg-none" tabindex="0" aria-controls="toc-collapse" aria-expanded="false">
            Menu
        </button>
    </div>
</div>
